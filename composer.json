{
    "name": "solution-forest/ocpp-php",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "SolutionForest\\OcppPhp\\": "src/"
        }
    },
    "authors": [
        {
            "name": "solution-forest",
            "email": "info+package@solutionforest.net"
        }
    ],
    "require": {
        "ramsey/uuid": "^4.7",
        "justinrainbow/json-schema": "^6.0"
    },
    "require-dev": {
        "nette/php-generator": "^4.1",
        "phpunit/phpunit": "^12.5",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-type-coverage": "^4.0",
        "phpstan/phpstan": "^2.3"
    },
    "suggest": {
        "react/socket": "Required for running WebSocket examples",
        "phrity/websocket": "Required for running WebSocket examples"
    },
    "bin": [
        "bin/ocpp-php"
    ],
    "scripts": {
        "test:types": "phpstan",
        "test:type-coverage": "pest --type-coverage --min=100"
    },
    "scripts-descriptions": {
        "test:types": "Run PHPStan at level max on the generated classes (see paths in phpstan.neon).",
        "test:type-coverage": "Require 100% type coverage of the generated classes (see <source> in phpunit.xml.dist)."
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
