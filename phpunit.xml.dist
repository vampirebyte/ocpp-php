<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="vendor/autoload.php" cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="default">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <!--
        Pest type coverage (composer test:type-coverage) checks only the directories listed
        here, so it covers the generated classes and not the hand-written package files.
    -->
    <source>
        <include>
            <directory>src/Ocpp/v16</directory>
            <directory>src/Ocpp/v201</directory>
            <directory>src/Ocpp/v21</directory>
        </include>
    </source>
</phpunit>